{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sley.invalid/schemas/sley2.benchmark.corpus.v1.schema.json",
  "title": "Sley 2 benchmark corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "status", "not_program_input", "tasks"],
  "properties": {
    "contract": {"const": "sley2-benchmark-corpus-v1"},
    "version": {"const": 1},
    "status": {"const": "FROZEN"},
    "not_program_input": {"const": true},
    "tasks": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "title", "goal", "required_outcome", "strict_oracle", "forbidden_outcomes"],
        "properties": {
          "id": {"type": "string", "pattern": "^S2B-[A-Z]+-[0-9]{3}$"},
          "class": {"type": "string"},
          "title": {"type": "string", "minLength": 1},
          "goal": {"type": "string", "minLength": 1},
          "required_outcome": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "strict_oracle": {"type": "object", "minProperties": 2},
          "forbidden_outcomes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
